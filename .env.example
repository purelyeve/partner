# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode keys from client; Connect enabled on account)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# EasyPost (test/live rates for inventory packages)
EASYPOST_API_KEY=
EASYPOST_SHIP_FROM_NAME=Purely Eve LLC
EASYPOST_SHIP_FROM_COMPANY=Purely Eve LLC
EASYPOST_SHIP_FROM_PHONE=
EASYPOST_SHIP_FROM_STREET1=
EASYPOST_SHIP_FROM_STREET2=
EASYPOST_SHIP_FROM_CITY=
EASYPOST_SHIP_FROM_STATE=CO
EASYPOST_SHIP_FROM_ZIP=
EASYPOST_SHIP_FROM_COUNTRY=US

# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Purely Eve <onboarding@yourdomain.com>

# Encrypt distributor Tax ID / SSN at rest (32-byte hex = 64 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TAX_ID_ENCRYPTION_KEY=

# First admin account — this email is promoted to admin on registration
ADMIN_BOOTSTRAP_EMAIL=admin@purelyeve.com
